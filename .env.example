# ===== 仓库根 .env（算法服务读取）=====
# 注意：Node 后端只读 server/.env（见 server/.env.example），
#       两边的 DASHSCOPE_API_KEY 需要是同一把有效 key。

# 数据库（算法侧当前不直接使用，保留以兼容旧配置；默认值与 Docker 容器一致）
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/mental_health?schema=public"

# JWT 配置
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# 通义千问 (DashScope) API
DASHSCOPE_API_KEY="your-dashscope-api-key"

# 服务端口
SERVER_PORT=3000
CLIENT_PORT=5173

# Redis (可选，后续配置)
REDIS_URL="redis://localhost:6379"

# 文件上传
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"
