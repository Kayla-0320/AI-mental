# ===== Node 后端环境变量模板 =====
# 用法：复制为 server/.env 后按需修改。
#   Copy-Item server\.env.example server\.env
# 注意：Node 端（dotenv，cwd=server/）只读本文件，不读仓库根 .env；
#       算法端只读仓库根 .env。两边的 DASHSCOPE_API_KEY 需要是同一把有效 key。

# 数据库（默认与 server.js 自动创建的 mh-postgres 容器一致）
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/mental_health?schema=public"

# JWT（演示默认值，部署前请更换）
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# 通义千问 (DashScope) API
# 留空时：Node 侧桥接会 401，聊天页会显示失败卡片；算法侧退回模板回复。
DASHSCOPE_API_KEY=""

# 服务端口
SERVER_PORT=3000
CLIENT_PORT=5173

# 算法服务
ALGORITHM_API_URL=http://localhost:8001

# Redis（可选）
REDIS_URL="redis://localhost:6379"

# 文件上传
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"
